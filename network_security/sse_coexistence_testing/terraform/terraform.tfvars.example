# Copy to terraform.tfvars and fill in the values for your environment.
# terraform.tfvars is .gitignored — never commit secrets.

aws_region        = "us-west-2"
availability_zone = "us-west-2a"
instance_type     = "t3.micro"

# REQUIRED: name of an existing EC2 key pair in `aws_region`.
# Create one with:
#   aws ec2 create-key-pair --key-name sse-coex-key \
#     --query "KeyMaterial" --output text > ~/.ssh/sse-coex-key.pem
#   chmod 400 ~/.ssh/sse-coex-key.pem
key_name = "sse-coex-key"

# REQUIRED: the operator's IP (/32) only. Never 0.0.0.0/0.
# Discover yours with: curl -s ifconfig.me
ssh_cidr_blocks = ["203.0.113.4/32"]

# HTTP can be open to the world for this test scenario.
http_cidr_blocks = ["0.0.0.0/0"]
